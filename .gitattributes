# Store every text file with LF line endings in the repository.
# Git decides what counts as text; binary files are left alone.
* text=auto

# Files that run on Linux (CI runners, Docker, the droplet) must stay LF,
# even in a Windows working copy.
gradlew         text eol=lf
*.sh            text eol=lf
Dockerfile      text eol=lf
Caddyfile       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows scripts must stay CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary files: never convert or diff as text.
*.jar           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.icns          binary
*.webp          binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.pdf           binary
*.zip           binary
